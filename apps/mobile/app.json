{
  "expo": {
    "name": "Flacon — Buy. Sell. Connect.",
    "slug": "flacon-marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "flacon",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.flacon.marketplace"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "in.flacon.marketplace"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Flacon to access your camera to take photos of items you want to sell."
        }
      ]
    ]
  }
}

